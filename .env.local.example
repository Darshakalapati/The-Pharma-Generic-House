NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications for new bookings, enquiries and messages.
# Both must be set for mail to go out — if either is missing the submission
# still succeeds and the server logs a warning instead.
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=shop-inbox@example.com
